# Общая часть сайта: API, статика Mini App, заголовки безопасности.
encode gzip
handle /api/* {
	reverse_proxy api:8000
}
handle {
	root * /srv
	try_files {path} /index.html
	file_server
}
header {
	Strict-Transport-Security "max-age=31536000"
	X-Content-Type-Options nosniff
	Referrer-Policy no-referrer
	Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors https://web.telegram.org https://*.telegram.org"
	-Server
}
