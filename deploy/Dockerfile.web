# Сборка Mini App и раздача через Caddy (HTTPS-сертификат выпускается автоматически).
# CADDY_MODE: standard — обычный Caddy на 80/443; duckdns — отдельный порт, сертификат через
# DNS-проверку DuckDNS; proxy — за Caddy другого приложения, который уже занимает 80/443.
ARG CADDY_MODE=standard

FROM node:22-alpine AS build
WORKDIR /src
COPY webapp/package.json webapp/package-lock.json ./
RUN npm ci
COPY webapp/ ./
RUN npm run build

FROM caddy:2.10.2-alpine AS caddy-standard
COPY deploy/caddy/Caddyfile /etc/caddy/Caddyfile

# Модуль DuckDNS v0.5.0 требует Caddy 2.10 и Go 1.24 — версии должны совпадать.
FROM caddy:2.10.2-builder-alpine AS caddy-builder
RUN xcaddy build --with github.com/caddy-dns/duckdns@v0.5.0

FROM caddy:2.10.2-alpine AS caddy-duckdns
COPY --from=caddy-builder /usr/bin/caddy /usr/bin/caddy
COPY deploy/caddy/Caddyfile.duckdns /etc/caddy/Caddyfile

FROM caddy:2.10.2-alpine AS caddy-proxy
COPY deploy/caddy/Caddyfile.proxy /etc/caddy/Caddyfile

FROM caddy-${CADDY_MODE}
COPY deploy/caddy/site.caddy /etc/caddy/site.caddy
COPY --from=build /src/dist /srv
