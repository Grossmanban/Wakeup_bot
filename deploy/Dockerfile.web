# Сборка Mini App и раздача через Caddy (HTTPS-сертификат выпускается автоматически).
# CADDY_MODE=standard — обычный Caddy; duckdns — Caddy с DNS-проверкой DuckDNS
# (для сервера, где порты 80/443 уже заняты другим сервисом).
ARG CADDY_MODE=standard

FROM node:22-alpine AS build
WORKDIR /src
COPY webapp/package.json webapp/package-lock.json ./
RUN npm ci
COPY webapp/ ./
RUN npm run build

FROM caddy:2.8-alpine AS caddy-standard
COPY deploy/caddy/Caddyfile /etc/caddy/Caddyfile

FROM caddy:2.8-builder-alpine AS caddy-builder
RUN xcaddy build --with github.com/caddy-dns/duckdns

FROM caddy:2.8-alpine AS caddy-duckdns
COPY --from=caddy-builder /usr/bin/caddy /usr/bin/caddy
COPY deploy/caddy/Caddyfile.duckdns /etc/caddy/Caddyfile

FROM caddy-${CADDY_MODE}
COPY deploy/caddy/site.caddy /etc/caddy/site.caddy
COPY --from=build /src/dist /srv
