# Скопируйте в .env и заполните. Файл .env не коммитится.

# Токен бота от @BotFather.
BOT_TOKEN=

# Имя бота без @ (для реферальных ссылок t.me/<бот>?start=ref_...).
BOT_USERNAME=

# Домен сервера, на котором будет Mini App (DNS A-запись должна указывать на сервер).
DOMAIN=app.example.ru
# Адрес Mini App для кнопки в боте — https://<DOMAIN>/
MINIAPP_URL=https://app.example.ru/

# Пароль базы данных (придумайте длинный случайный).
POSTGRES_PASSWORD=

# Telegram ID владельцев через запятую. Узнать свой ID: @userinfobot.
OWNER_TELEGRAM_IDS=

# Сколько секунд действует подпись входа из Telegram (по умолчанию сутки).
INIT_DATA_MAX_AGE=86400

# Только если Mini App открывается с другого домена, чем API.
CORS_ORIGINS=

# Движок OCR: onnx (по умолчанию, ~0,5 ГБ памяти) или none — тогда фото с проверкой текста
# уходят на ручную проверку.
OCR_ENGINE=onnx
# 0 — собрать образ без OCR (при OCR_ENGINE=none; образ меньше примерно на 300 МБ).
WITH_OCR=1

# Заполняет install.sh. Если порты 80/443 заняты другим сервисом:
# CADDY_MODE=duckdns (сертификат через DuckDNS), HTTPS_PUBLISH=8443, HTTP_PUBLISH=127.0.0.1:18080.
CADDY_MODE=standard
HTTP_PUBLISH=80
HTTPS_PUBLISH=443
# Токен DuckDNS: для сертификата в режиме duckdns и для обновления IP.
DUCKDNS_TOKEN=
